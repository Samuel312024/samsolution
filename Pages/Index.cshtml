    <style>
        :root {
            --bg-base: #020617;
            --panel: rgba(15, 23, 42, 0.74);
            --panel-strong: rgba(15, 23, 42, 0.92);
            --border: rgba(148, 163, 184, 0.18);
            --accent: #38bdf8;
            --accent-strong: #2563eb;
        }

        body {
            font-family: "Sora", sans-serif;
            background:
                radial-gradient(circle at top, rgba(37, 99, 235, 0.22), transparent 30%),
                radial-gradient(circle at 15% 20%, rgba(14, 165, 233, 0.14), transparent 20%),
                linear-gradient(180deg, #020617 0%, #020617 44%, #030712 100%);
        }

        .fade-up {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s ease;
        }

        .fade-up.active {
            opacity: 1;
            transform: translateY(0);
        }

        .hover-glow:hover {
            box-shadow: 0 0 28px rgba(59, 130, 246, 0.18);
        }

        .glass-panel {
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.94) 0%, rgba(15, 23, 42, 0.78) 100%);
            border: 1px solid var(--border);
            box-shadow: 0 32px 80px rgba(2, 6, 23, 0.55);
            backdrop-filter: blur(18px);
        }

        .hero-orb {
            position: absolute;
            border-radius: 999px;
            filter: blur(100px);
            opacity: 0.38;
            pointer-events: none;
        }

        .metric-card {
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.72));
            border: 1px solid rgba(96, 165, 250, 0.14);
        }

        .signal-card {
            background:
                linear-gradient(180deg, rgba(15, 23, 42, 0.94), rgba(6, 12, 24, 0.94)),
                radial-gradient(circle at top left, rgba(56, 189, 248, 0.08), transparent 32%);
            border: 1px solid rgba(96, 165, 250, 0.14);
            box-shadow: 0 30px 60px rgba(2, 6, 23, 0.3);
        }

        .signal-step {
            border: 1px solid rgba(148, 163, 184, 0.12);
            background: rgba(2, 6, 23, 0.34);
        }

        .contact-card {
            background:
                linear-gradient(180deg, rgba(8, 15, 29, 0.98), rgba(3, 7, 18, 0.98)),
                radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 30%);
            border: 1px solid rgba(56, 189, 248, 0.18);
            box-shadow: 0 34px 70px rgba(2, 6, 23, 0.4);
        }

        .trust-chip {
            border: 1px solid rgba(148, 163, 184, 0.16);
            background: rgba(15, 23, 42, 0.72);
        }

        .lead-label {
            display: block;
            margin-bottom: 0.55rem;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #bae6fd;
        }

        .lead-input,
        .lead-textarea {
            width: 100%;
            border-radius: 18px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: rgba(15, 23, 42, 0.82);
            color: #e2e8f0;
            padding: 0.95rem 1rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .lead-input::placeholder,
        .lead-textarea::placeholder {
            color: #64748b;
        }

        .lead-input:focus,
        .lead-textarea:focus {
            outline: none;
            border-color: rgba(56, 189, 248, 0.62);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.14);
            background: rgba(15, 23, 42, 0.96);
        }

        .lead-textarea {
            min-height: 132px;
            resize: vertical;
        }

        .lead-field {
            display: block;
        }

        .lead-input.is-invalid,
        .lead-textarea.is-invalid {
            border-color: rgba(248, 113, 113, 0.72);
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
        }

        .lead-error {
            display: block;
            min-height: 1.3rem;
            margin-top: 0.55rem;
            font-size: 0.78rem;
            color: #fca5a5;
        }

        .lead-submit:disabled {
            cursor: wait;
            opacity: 0.84;
            transform: none;
        }

        .cta-panel {
            background:
                linear-gradient(135deg, rgba(14, 165, 233, 0.14), rgba(37, 99, 235, 0.18)),
                linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(2, 6, 23, 0.98));
            border: 1px solid rgba(96, 165, 250, 0.16);
            box-shadow: 0 38px 80px rgba(2, 6, 23, 0.34);
        }

        @@media (max-width: 768px) {
            .lead-input,
            .lead-textarea {
                font-size: 16px;
            }
        }
    </style>
</head>


    <script>
        const elements = document.querySelectorAll('.fade-up');
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.16 });

        elements.forEach(el => observer.observe(el));
        document.getElementById("ano").textContent = new Date().getFullYear();
    </script>

    <script>
        (() => {
            const leadForms = Array.from(document.querySelectorAll('[data-lead-form]'));
            if (!leadForms.length) {
                return;
            }

            function getDigits(value) {
                return value.replace(/\D/g, '').slice(0, 11);
            }

            function formatPhone(value) {
                const digits = getDigits(value);

                if (!digits) {
                    return '';
                }

                if (digits.length <= 2) {
                    return `(${digits}`;
                }

                if (digits.length <= 6) {
                    return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
                }

                if (digits.length <= 10) {
                    return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
                }

                return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
            }

            function isValidEmail(value) {
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/i.test(value);
            }

            function setFieldError(form, field, message) {
                const errorElement = form.querySelector(`[data-error-for="${field.name}"]`);
                const hasError = Boolean(message);

                field.classList.toggle('is-invalid', hasError);
                field.setAttribute('aria-invalid', String(hasError));

                if (errorElement) {
                    errorElement.textContent = message;
                }
            }

            function validateField(form, field) {
                const value = field.value.trim();

                switch (field.name) {
                    case 'nome':
                        if (value.length < 3) {
                            return 'Informe seu nome para seguirmos com o contato.';
                        }
                        return '';
                    case 'telefone':
                        if (getDigits(value).length < 10) {
                            return 'Informe um WhatsApp com DDD válido.';
                        }
                        return '';
                    case 'email':
                        if (!value) {
                            return '';
                        }
                        if (!isValidEmail(value)) {
                            return 'Digite um e-mail válido ou deixe este campo em branco.';
                        }
                        return '';
                    case 'desafio':
                        if (value.length < 12) {
                            return 'Descreva rapidamente o principal desafio da sua empresa.';
                        }
                        return '';
                    default:
                        if (field.required && !value) {
                            return 'Este campo é obrigatório.';
                        }
                        return '';
                }
            }

            leadForms.forEach((form) => {
                const fields = Array.from(form.querySelectorAll('input, textarea'));
                const phoneInput = form.querySelector('input[name="telefone"]');

                phoneInput?.addEventListener('input', () => {
                    phoneInput.value = formatPhone(phoneInput.value);

                    if (phoneInput.dataset.touched === 'true') {
                        setFieldError(form, phoneInput, validateField(form, phoneInput));
                    }
                });

                fields.forEach((field) => {
                    field.addEventListener('blur', () => {
                        field.dataset.touched = 'true';
                        setFieldError(form, field, validateField(form, field));
                    });

                    if (field !== phoneInput) {
                        field.addEventListener('input', () => {
                            if (field.dataset.touched === 'true') {
                                setFieldError(form, field, validateField(form, field));
                            }
                        });
                    }
                });

                form.addEventListener('submit', (event) => {
                    event.preventDefault();
                    if (form.dataset.submitting == "true") {
                        return;
                    }

                    let firstInvalidField = null;
                    fields.forEach((field) => {
                        field.dataset.touched = 'true';
                        const errorMessage = validateField(form, field);
                        setFieldError(form, field, errorMessage);

                        if (errorMessage && !firstInvalidField) {
                            firstInvalidField = field;
                        }
                    });

                    if (firstInvalidField) {
                        firstInvalidField.focus();
                        return;
                    }

                    const data = new FormData(form);
                    const whatsappNumber = form.getAttribute('data-whatsapp-number') || '5519986093543';
                    const nome = String(data.get('nome') || '').trim();
                    const empresa = String(data.get('empresa') || '').trim();
                    const telefone = String(data.get('telefone') || '').trim();
                    const email = String(data.get('email') || '').trim();
                    const desafio = String(data.get('desafio') || '').trim();
                    const submitButton = form.querySelector('button[type="submit"]');

                    const messageLines = [
                        'Olá, vim pelo site da SAM SOLUTION e gostaria de solicitar um diagnóstico de TI.',
                        '',
                        `Nome: ${nome || 'Não informado'}`,
                        `Empresa: ${empresa || 'Não informado'}`,
                        `WhatsApp: ${telefone || 'Não informado'}`,
                        `E-mail: ${email || 'Não informado'}`,
                        `Principal desafio: ${desafio || 'Não informado'}`
                    ];

                    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(messageLines.join('\n'))}`;

                    if (typeof trackClick === 'function') {
                        trackClick('lead_form_whatsapp');
                    }

                    form.dataset.submitting = 'true';
                    if (submitButton instanceof HTMLButtonElement) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Abrindo WhatsApp...';
                    }

                    window.location.assign(whatsappUrl);
                });
            });
        })();
    </script>

    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E17CGRFC2B');

      function trackClick(nome) {
        gtag('event', nome, {
            event_category: 'interacao',
